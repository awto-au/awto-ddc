+
+    def read(u):
+        nonlocal virtual_seconds
+        calls[u] += 1
+        if u >= U0:
+            virtual_seconds += 1 / 15               # > 5 minutes for the body
+            # Publish a different hint every body read. This must not restart.
+            n = 5142 + int(virtual_seconds)
