void AwtoLogoDraw(void)
{
    BYTE r, c, n, id;
    WORD i = 0;

    for(r = 0; r < AWTO_LOGO_ROWS; r++)
    {
        for(c = 0; c < AWTO_LOGO_COLS; c += n)
        {
            n = tAWTO_LOGO_RUNS[i++];
            id = tAWTO_LOGO_RUNS[i++];
            ScalerOsdCharCommandAllByteSeries(g_usFontSelectStart + (WORD)r * AWTO_LOGO_COLS + c, 0x4C, id, COLOR(_LOGO_CP_BG, _LOGO_CP_BG), n);
        }
    }
}
